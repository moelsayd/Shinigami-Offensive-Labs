#!/bin/bash
BASE="$HOME/ctf-labs"

# Colors
GREEN='\e[1;32m'
YELLOW='\e[1;33m'
ORANGE='\e[38;5;208m'
RED='\e[1;31m'
PURPLE='\e[38;5;93m'
CYAN='\e[1;36m'
RESET='\e[0m'

show_room() {
    local room="$1"
    local room_name=$(basename "$room")
    local stop_script="$room/stop.sh"
    local start_script="$room/start.sh"

    [ -f "$stop_script" ] && bash "$stop_script" &>/dev/null

    clear
    echo "☠️  $room_name"
    echo "================================="

    if [ -f "$start_script" ]; then
        bash "$start_script"
        if [ $? -ne 0 ]; then
            read -p "Target start failed. Press Enter to return..."
            return
        fi
    fi

    if [ -f "$room/tasks.txt" ]; then
        echo -e "\n📜 Tasks:"
        cat "$room/tasks.txt"
    fi

    echo ""
    echo "--- Actions ---"
    echo "f) Submit flag"
    echo "h) Show hints"
    echo "r) Restart target"
    if grep -q "PORT=" "$start_script" 2>/dev/null; then
        echo "t) Test connection to target"
    else
        echo "t) (not available)"
    fi
    echo "s) Stop target & return"
    echo "q) Quit lab"
    echo "======================"

    while true; do
        read -p "Action: " action
        case "$action" in
            f) [ -f "$room/submit_flag.sh" ] && bash "$room/submit_flag.sh" || echo "No submit script." ;;
            h) [ -f "$room/hints.txt" ] && cat "$room/hints.txt" || echo "No hints." ;;
            r)
                [ -f "$stop_script" ] && bash "$stop_script" &>/dev/null
                [ -f "$start_script" ] && bash "$start_script"
                ;;
            t)
                local port=$(grep -oP 'PORT=\K[0-9]+' "$start_script" 2>/dev/null)
                if [ -n "$port" ]; then
                    echo "🔍 Testing http://localhost:$port ..."
                    curl -s -o /dev/null -w "HTTP Status: %{http_code}\n" --connect-timeout 3 "http://localhost:$port" || echo "❌ Cannot reach target."
                else
                    echo "⚠️  This action is only for network-based rooms."
                fi
                ;;
            s) [ -f "$stop_script" ] && bash "$stop_script"; break ;;
            q) exit 0 ;;
            *) echo "Unknown action." ;;
        esac
    done
}

# Calculate total points for rooms in a given level directory
level_scoreboard() {
    local level_dir="$1"
    local progress_file="$BASE/progress.txt"
    local total=0

    #echo "📊 Scoreboard for $(basename "$level_dir") Level"
    echo -e "${CYAN}📊 Scoreboard for $(basename "$level_dir") Level${RESET}"
    echo "----------------------------------------"

    if [ ! -f "$progress_file" ]; then
        echo "No progress recorded yet."
    else
        # List all room directories inside the level
        for room_path in "$level_dir"/room*; do
            [ -d "$room_path" ] || continue
            local room_name=$(basename "$room_path")
            local points=$(grep "^${room_name}:" "$progress_file" 2>/dev/null | cut -d: -f2)
            if [ -n "$points" ]; then
                echo "$room_name : $points"
                total=$((total + points))
            fi
        done
        echo "----------------------------------------"
        echo "Total Points: $total"
    fi
    echo ""
}

# Menu for a specific level: lists rooms dynamically, allows playing, scoreboard, back.
level_menu() {
    local level_dir="$1"
    local level_name=$(basename "$level_dir")
    local rooms=()

    # Collect room directories sorted by number
    while IFS= read -r room_path; do
        rooms+=("$room_path")
    done < <(find "$level_dir" -maxdepth 1 -type d -name "room*" | sort -V)

    while true; do
        clear
        echo -e "${CYAN}===================================${RESET}"
        echo -e "${CYAN}☠️  Shinigami CTF Lab - ${level_name} Level${RESET}"
        echo -e "${CYAN}===================================${RESET}"

        local index=1
        for room_path in "${rooms[@]}"; do
            local room_name=$(basename "$room_path")
            echo "$index) $room_name"
            index=$((index + 1))
        done

        echo ""
        echo "s) 📊 Level Scoreboard"
        echo "b) 🔙 Back to level selection"
        echo "q) Quit lab"
        echo "============================================="

        read -p "Choose: " choice
        case "$choice" in
            q) exit 0 ;;
            b) return ;;
            s) level_scoreboard "$level_dir"; read -p "Press Enter to continue..." ;;
            *)
                if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#rooms[@]}" ]; then
                    local room_path="${rooms[$((choice-1))]}"
                    show_room "$room_path"
                else
                    echo "Invalid option."
                    sleep 1
                fi
                ;;
        esac
    done
}

# Main menu: select difficulty or view overall scoreboard/reset/quit
while true; do
    clear
    echo -e "${PURPLE}=========================${RESET}"
    echo -e "${PURPLE}😈 Shinigami CTF Lab 😈${RESET}"
    echo -e "${PURPLE}=========================${RESET}"
    echo -e "${GREEN}1) Easy${RESET}"
    echo -e "${YELLOW}2) Medium${RESET}"
    echo -e "${ORANGE}3) Medium-Advanced${RESET}"
    echo -e "${RED}4) Hard${RESET}"
    echo -e "${PURPLE}5) Android-Exam${RESET}"
    echo -e "${PURPLE}6) Blackbox-Reality-Exam${RESET}"


    echo ""
    echo "s) 📊 Overall Scoreboard"
    echo "r) 🔄 Reset all progress"
    echo "q) Quit"
    read -p "Choose: " choice

    case "$choice" in
        1) level_menu "$BASE/Easy" ;;
        2) level_menu "$BASE/Medium" ;;
        3) level_menu "$BASE/Medium-Advanced" ;;
        4) level_menu "$BASE/Hard" ;;
        5) level_menu "$BASE/Android-Exam" ;;
        6) level_menu "$BASE/Blackbox-Reality-Exam" ;;
        s)
            clear
            echo -e "${CYAN}===================================${RESET}"
            echo -e "${CYAN}=== Overall Shinigami CTF Progress ===${RESET}"
            echo -e "${CYAN}===================================${RESET}"
            if [ -f "$BASE/progress.txt" ]; then
                cat "$BASE/progress.txt"
                total=$(awk -F: '{sum+=$2} END{print sum}' "$BASE/progress.txt" 2>/dev/null)
                echo "----------------------------------------"
                echo "Total Points: $total"
            else
                echo "No progress recorded yet."
            fi
            read -p "Press Enter to return..."
            ;;
        r)
            read -p "Are you sure you want to delete ALL progress? (yes/no): " confirm
            if [ "$confirm" = "yes" ]; then
                rm -f "$BASE/progress.txt"
                echo "🗑️  All progress has been reset."
            else
                echo "Reset cancelled."
            fi
            read -p "Press Enter to continue..."
            ;;
        q) exit 0 ;;
        *) sleep 1 ;;
    esac
done
