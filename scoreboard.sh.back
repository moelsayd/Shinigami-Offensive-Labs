#!/bin/bash

CYAN='\e[1;36m'
YELLOW='\e[1;33m'
RESET='\e[0m'

BASE="$HOME/ctf-labs"
PROGRESS="$BASE/progress.txt"

#echo "=== 🏆 Shinigami CTF Scoreboard ==="
echo -e "${YELLOW}=== 🏆 Shinigami CTF Scoreboard ===${RESET}"

echo ""

if [ ! -f "$PROGRESS" ]; then
    echo "No progress recorded yet."
    exit 0
fi

# عرض تفصيلي حسب المستويات (إن وجدت)
for level in Easy Medium Medium-Advanced Hard; do
    level_dir="$BASE/$level"
    if [ -d "$level_dir" ]; then
        echo "[$level]"
        level_total=0
        for room in "$level_dir"/room*; do
            [ -d "$room" ] || continue
            room_name=$(basename "$room")
            pts=$(grep "^${room_name}:" "$PROGRESS" 2>/dev/null | cut -d: -f2)
            if [ -n "$pts" ]; then
                echo "  $room_name : $pts"
                level_total=$((level_total + pts))
            fi
        done
        echo "  >> Level Total: $level_total"
        echo ""
    fi
done

# الإجمالي الكلي
total=$(awk -F: '{sum+=$2} END{print sum}' "$PROGRESS")
echo "============================="
echo "🎯 Total Points: $total"
